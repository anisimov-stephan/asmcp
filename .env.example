# Copy to .env.dev (and .env.stage / .env.prod) and fill in real values.

# PostgreSQL connection string
DATABASE_URL=postgresql://micro_user:micro_password@localhost:5432/micro_db

# Mode: dev / stage / prod
MICRO_MODE=dev

# Keycloak auth (empty KEYCLOAK_URL -> 500 "Keycloak is not configured" on protected endpoints)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=master

# APISIX Admin API
APISIX_ADMIN_URL=http://apisix:9180
APISIX_ADMIN_KEY=changeme

# GitLab / MPSDK
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-changeme
MPSDK_PROJECT_ID=123
MPSDK_BASE_BRANCH=main

# Timeout for APISIX/GitLab HTTP calls (seconds)
EXTERNAL_HTTP_TIMEOUT_S=30
